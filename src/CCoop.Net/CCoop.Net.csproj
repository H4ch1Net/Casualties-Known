<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game-independent networking: wire format, message registry, sessions and
    transports. netstandard2.0 so it loads under Unity's Mono (net472) and under
    the net8.0 test host. Builds and tests with no game install.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>CCoop.Net</RootNamespace>
    <AssemblyName>CCoop.Net</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.3.5 is the newest LiteNetLib with a netstandard2.0 target (2.x is
         net8.0/netstandard2.1 only, which net472 cannot load). MIT. -->
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>

</Project>
