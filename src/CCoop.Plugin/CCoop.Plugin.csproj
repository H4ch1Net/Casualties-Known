<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CCoop.Plugin</AssemblyName>
    <RootNamespace>CCoop.Plugin</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="CCoopCheckGamePath" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(GameManagedPath)' == '' Or !Exists('$(GameManagedPath)')">
    <Error Text="GamePath is not set or invalid. Copy GamePath.Local.props.example to GamePath.Local.props and point it at the full game. (Resolved GameManagedPath='$(GameManagedPath)')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\CCoop.Net\CCoop.Net.csproj" />
  </ItemGroup>

  <!-- Game, Unity and loader assemblies are referenced in place and never copied. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(GameManagedPath)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(GameManagedPath)\UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameManagedPath)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManagedPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(GameManagedPath)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManagedPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(GameManagedPath)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TilemapModule"><HintPath>$(GameManagedPath)\UnityEngine.TilemapModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.GridModule"><HintPath>$(GameManagedPath)\UnityEngine.GridModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(GameManagedPath)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManagedPath)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManagedPath)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(GameManagedPath)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(GameManagedPath)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copies the plugin and its managed dependencies into BepInEx\plugins\CasualtiesCoop. -->
  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <CCoopDeploy Include="$(TargetDir)CCoop.Plugin.dll;$(TargetDir)CCoop.Plugin.pdb;$(TargetDir)CCoop.Net.dll;$(TargetDir)LiteNetLib.dll" />
    </ItemGroup>
    <MakeDir Directories="$(GameBepInExPluginPath)\CasualtiesCoop" />
    <Copy SourceFiles="@(CCoopDeploy)" DestinationFolder="$(GameBepInExPluginPath)\CasualtiesCoop" />
    <Message Importance="high" Text="Deployed to $(GameBepInExPluginPath)\CasualtiesCoop" />
  </Target>

  <!-- Builds a ready-to-share zip under dist\ (Release only). -->
  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <StageDir>$(MSBuildThisFileDirectory)..\..\dist\stage\BepInEx\plugins\CasualtiesCoop</StageDir>
      <ZipPath>$(MSBuildThisFileDirectory)..\..\dist\CasualtiesCoop-$(Version).zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(MSBuildThisFileDirectory)..\..\dist\stage" />
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetDir)CCoop.Plugin.dll;$(TargetDir)CCoop.Net.dll;$(TargetDir)LiteNetLib.dll" DestinationFolder="$(StageDir)" />
    <!-- The installer sits beside the BepInEx folder in the zip. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\tools\install.ps1" DestinationFolder="$(MSBuildThisFileDirectory)..\..\dist\stage" />
    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)..\..\dist\stage" DestinationFile="$(ZipPath)" />
    <Message Importance="high" Text="Packaged $(ZipPath)" />
  </Target>

</Project>
