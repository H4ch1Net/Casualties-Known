<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>CCoop.Transport.LiteNet</RootNamespace>
    <AssemblyName>CCoop.Transport.LiteNetLib</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to 1.3.5 deliberately. LiteNetLib 2.x (2.1.4 current) ships only
      net8.0 and netstandard2.1 assemblies; a BepInEx 5 plugin targeting net472
      on Unity's Mono runtime cannot consume netstandard2.1. 1.3.5 is the newest
      release with a netstandard2.0 target, which net472 can reference.
      Versions 1.1.0-1.3.1 are marked deprecated upstream.
      MIT licensed - see third_party/LiteNetLib-LICENSE.txt.
    -->
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
    <ProjectReference Include="..\CCoop.Transport\CCoop.Transport.csproj" />
    <ProjectReference Include="..\CCoop.Protocol\CCoop.Protocol.csproj" />
  </ItemGroup>

</Project>
